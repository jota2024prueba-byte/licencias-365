import streamlit as st
import pandas as pd

GOOGLE_SHEET_ID = "1O3fjQBNkTR0I7c28xTXkVRr8Szs_-YH9S0o149mLsa4/edit?pli=1&gid=0#gid=0"
SHEET_NAME = "365"

USUARIOS = {
    "cristian.vicioso": "Vic26*+*",
    "alfonso.gomez": "Poncho26*+*",
    "jorge.cantillo": "Joca*+*",
}

st.set_page_config(page_title="Licencias 365", page_icon="💻", layout="wide")

if "usuario" not in st.session_state:
    st.title("🔐 Acceso Restringido")
    u = st.text_input("Usuario")
    p = st.text_input("Contraseña", type="password")
    if st.button("Ingresar"):
        if u in USUARIOS and p == USUARIOS[u]:
            st.session_state.usuario = u
            st.rerun()
        else:
            st.error("❌ Datos incorrectos")
    st.stop()

@st.cache_data(ttl=60)
def cargar():
    url = f"https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/gviz/tq?tqx=out:csv&sheet={SHEET_NAME}"
    try:
        df = pd.read_csv(url, on_bad_lines="skip", engine="python")
        df.columns = df.columns.str.strip()
        st.write("📋 Columnas reales:", list(df.columns))
        return df
    except Exception as e:
        st.error(f"Error: {e}")
        return None

df = cargar()
st.title("📋 Consulta Licencias 365")
st.caption(f"👤 Conectado: {st.session_state.usuario}")
st.markdown("---")

if df is not None:
    st.write("📋 Buscando columnas...")
    col_dep = None
    for c in df.columns:
        if "DEPENDENCIA" in c.upper():
            col_dep = c
            break
    
    if not col_dep:
        st.error(f"❌ No encontré Dependencia. Columnas: {list(df.columns)}")
    else:
        col_usu = next((c for c in df.columns if "USUARIO" in c.upper()), None)
        col_cod = next((c for c in df.columns if "COD" in c.upper() and "ACTIVO" in c.upper()), None)
        col_ser = next((c for c in df.columns if "SERIAL" in c.upper()), None)
        col_pc = next((c for c in df.columns if "EQUIPO" in c.upper() or "COMPUTADOR" in c.upper()), None)
        col_lic = next((c for c in df.columns if "LICENCIA" in c.upper()), None)

        bus = st.text_input("🔍 Buscar")
        dep_sel = st.selectbox("Dependencia", ["Todas"] + sorted(df[col_dep].dropna().unique().tolist()))
        
        res = df.copy()
        if bus and col_cod:
            filtro = False
            for c in [col_cod, col_ser, col_pc, col_usu, col_dep]:
                if c: filtro |= res[c].astype(str).str.contains(bus, case=False, na=False)
            res = res[filtro]
        if dep_sel != "Todas":
            res = res[res[col_dep] == dep_sel]

        st.info(f"✅ {len(res)} encontrados")
        for _, eq in res.iterrows():
            st.markdown(f"{eq.get(col_pc,'')} · {eq.get(col_cod,'')} · {eq.get(col_usu,'')}")
            st.divider()

if st.button("Cerrar sesión"):
    del st.session_state.usuario
    st.rerun()
